#compdef lite

# Zsh completion for lite

_lite() {
    _arguments -s \
        '(- *)'{-h,--help}'[Show help and the config file location]' \
        '(- *)'{-v,--version}'[Show the installed version]' \
        '(- *)'{-u,--update}'[Update lite to the latest release]' \
        '*:file:_files'
}

_lite "$@"
